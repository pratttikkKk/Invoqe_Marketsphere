# ==============================================================================
# MarketSphere: Backend Environment Configuration Template
# ==============================================================================

# Server Runtime Configuration
PORT=5002
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/marketsphere

# Cryptographic Token Security (Mandatory >= 32 chars in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production

# Frontend Client Origin (Strict CORS whitelist; comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Admin Initial Bootstrap Credentials (Executed strictly via CLI: npm run bootstrap:admin)
ADMIN_EMAIL=admin@marketsphere.com
ADMIN_PASSWORD=Admin@SecurePassword2026!
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Administrator

# Payment Gateway Configuration (Razorpay / Sandbox)
PAYMENT_PROVIDER=SANDBOX
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Persistent Object Storage (Cloudinary / AWS S3)
IMAGE_STORAGE_PROVIDER=LOCAL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# TRANSACTIONAL EMAIL PROVIDER (HTTPS REST API - Immune to Render SMTP Blocks)
# ==============================================================================
# Supported Providers:
#   'resend'  : Modern HTTPS API (https://resend.com) - Free tier: 3,000 emails/mo, 100/day
#               Requires verified custom domain to send to arbitrary Gmail recipients.
#               (Sandbox 'onboarding@resend.dev' sends ONLY to your Resend account email).
#   'brevo'   : Modern HTTPS API (https://brevo.com) - Free tier: 300 emails/day
#               Supports Single Sender Verification without custom domain!
#               (You can verify a personal @gmail.com address in Brevo & send to any user).
#   'console' : Safe mock/console dispatch for local offline development.
EMAIL_PROVIDER=resend

# Default Sender Identity
EMAIL_FROM=MarketSphere <onboarding@resend.dev>

# Provider 1: Resend (https://resend.com)
# Create a free account -> API Keys -> Create API Key -> Paste below:
RESEND_API_KEY=re_your_resend_api_key_here

# Provider 2: Brevo (https://brevo.com)
# Create a free account -> Senders, Domains & Dedicated IPs -> Senders -> Add your Gmail address
# -> Click verification link in your inbox -> SMTP & API -> API Keys -> Generate Key:
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
